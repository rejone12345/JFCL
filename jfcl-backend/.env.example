# =============================================================================
# JFCL Backend — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# NEVER use these demo values in a production environment.
# =============================================================================

# Server
NODE_ENV=development
PORT=5000

# CORS — allow the React frontend origin
FRONTEND_URL=http://localhost:5173

# JWT — CHANGE THESE before any real deployment
JWT_SECRET=REPLACE_WITH_A_STRONG_256_BIT_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# Cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Rate limiting (requests per 15 min window)
RATE_LIMIT_MAX=100

# =============================================================================
# MongoDB — NOT connected in Phase 1. Leave blank until Phase 2.
# MONGODB_URI=
# =============================================================================
