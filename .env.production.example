# =============================================================================
# Production Environment Variables for Docker Deployment
# =============================================================================

# MongoDB Atlas Connection URI
MONGODB_URI=your_mongodb_atlas_connection_string

# Strong JWT Secret (e.g. 64 random characters)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key

# Public URL or IP of your Azure VM (e.g. http://20.198.xxx.xxx or http://yourdomain.com)
FRONTEND_URL=http://localhost
